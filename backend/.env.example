# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration (Defaults to gemini-3.1-flash-lite for maximum free-tier RPM/RPD)
GEMINI_MODEL=gemini-3.1-flash-lite

# Allowed Origins for CORS (e.g., https://your-app.vercel.app or * for all)
ALLOWED_ORIGINS=*

# Port (Optional, Render assigns PORT automatically)
PORT=8000

